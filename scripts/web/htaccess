# Unbottl web — Apache config for unbottl.com/public_html
#
# The Expo web export is a single-page app: one index.html and a JS bundle that
# routes on the client. Ask Apache for /m/<venue> and it looks for a directory
# that does not exist and returns 404, which is exactly what a guest scanning a
# QR code would get. Everything that is not a real file is handed to index.html
# so the client router can take over.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Real files and directories are served as themselves — the JS bundle, the
  # fonts, the favicon.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is a client route.
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Fingerprinted assets never change under the same name, so cache hard.
  <FilesMatch "\.(js|css|woff2?|ttf|png|jpg|jpeg|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # index.html must not be cached, or a deploy will not reach anyone still
  # holding the old one — and it is the file that names the current bundle.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # A menu is a public read-only page; it has no business in a frame on
  # someone else's site.
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
